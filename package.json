{
  "name": "magnitola",
  "version": "1.2.1",
  "description": "Music & Metadata Downloader and Player with ID3v2.3 tagging",
  "main": "main.js",
  "author": "MAGNItola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koko4267/magnitola.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:installer": "npm run build",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,html,css,json}\""
  },
  "keywords": [
    "music",
    "downloader",
    "player",
    "mp3",
    "electron",
    "soundcloud"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  },
  "build": {
    "appId": "com.magnitola.downloader",
    "productName": "MAGNItola",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "MAGNItola-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "installerSidebar": "installer/wizard-sidebar.bmp",
      "uninstallerSidebar": "installer/wizard-sidebar.bmp",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAGNItola",
      "artifactName": "MAGNItola-Setup-${version}.${ext}",
      "uninstallDisplayName": "MAGNItola"
    },
    "extraResources": [
      "licenses/lamejs"
    ],
    "files": [
      "index.html",
      "main.js",
      "library.cjs",
      "track-files.cjs",
      "preload.js",
      "lame.min.js",
      "css/**/*",
      "js/**/*",
      "magnitolalogo.jpg",
      "synclinelogo.jpg",
      "ru.png",
      "us.png",
      "icon.ico",
      "fonts/**/*"
    ]
  }
}
