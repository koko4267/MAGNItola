{
  "name": "magnitola",
  "version": "1.0.0",
  "description": "Music & Metadata Downloader and Player with ID3v2.3 tagging",
  "main": "main.js",
  "author": "MAGNItola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koko4267/magnitola.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win zip --x64 --publish never",
    "build:exe": "electron-builder --win portable --x64 --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,html,css,json}\""
  },
  "keywords": [
    "music",
    "downloader",
    "player",
    "mp3",
    "electron",
    "soundcloud"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "build": {
    "appId": "com.magnitola.downloader",
    "productName": "MAGNItola",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "MAGNItola-Windows.${ext}"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "lame.min.js",
      "css/**/*",
      "js/**/*",
      "magnitolalogo.jpg",
      "synclinelogo.jpg",
      "ru.png",
      "us.png",
      "icon.ico",
      "fonts/**/*"
    ]
  }
}
